# Port d'écoute
PORT=3000

# URL publique du site (utilisée pour les redirections Stripe)
BASE_URL=http://localhost:3000

# Mot de passe de l'interface admin.
# Si vide, un mot de passe aleatoire est genere et affiche au demarrage.
ADMIN_PASSWORD=

# Cle secrete Stripe (sk_test_... ou sk_live_...).
# Si vide, l'application demarre en MODE DEMO : le paiement est simule.
STRIPE_SECRET_KEY=

# Prix en centimes (100 = 1,00 EUR)
PRICE_CENTS=100

# Secret de signature des cookies. Genere automatiquement si absent.
APP_SECRET=
