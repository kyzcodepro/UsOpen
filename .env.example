# --- Obligatoire ---

# Connexion PostgreSQL. Utilisez l'endpoint *poolé* du fournisseur
# (Vercel Postgres / Neon / Supabase), pas la connexion directe.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Mot de passe de l'interface admin.
ADMIN_PASSWORD=

# Secret de signature des cookies (accès payé + session admin).
# Générez-le avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Obligatoire en production : sans lui, chaque instance signerait différemment
# et les accès payés seraient invalides d'une requête à l'autre.
APP_SECRET=

# --- Recommandé ---

# URL publique du site, utilisée pour les redirections Stripe.
# Sur Vercel : https://votre-projet.vercel.app
BASE_URL=http://localhost:3000

# Clé secrète Stripe (sk_test_... ou sk_live_...).
# Si vide, l'application démarre en MODE DÉMO : le paiement est simulé.
STRIPE_SECRET_KEY=

# --- Optionnel ---

# Port d'écoute en local (ignoré en serverless).
PORT=3000

# Prix en centimes (100 = 1,00 EUR)
PRICE_CENTS=100
