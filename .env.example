# --- Obligatoire ---

# Base Turso (libSQL).
#   Production : libsql://<votre-base>-<org>.turso.io
#   Local      : file:data/local.db  (fichier SQLite, aucun réseau, aucun jeton)
TURSO_DATABASE_URL=file:data/local.db

# Jeton d'accès Turso. Obligatoire dès que l'URL est distante (libsql://).
# Obtenu avec : turso db tokens create <votre-base>
TURSO_AUTH_TOKEN=

# Mot de passe de l'interface admin.
ADMIN_PASSWORD=

# Secret de signature des cookies (accès payé + session admin).
# Générez-le avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Obligatoire en production : sans lui, chaque instance signerait différemment
# et les accès payés seraient invalides d'une requête à l'autre.
APP_SECRET=

# --- Recommandé ---

# URL publique du site, utilisée pour les redirections Stripe.
# Sur Vercel : https://votre-projet.vercel.app
BASE_URL=http://localhost:3000

# Clé secrète Stripe (sk_test_... ou sk_live_...).
# Si vide, l'application démarre en MODE DÉMO : le paiement est simulé.
# Dès qu'elle est définie, BASE_URL doit pointer sur le site réel : c'est là
# que Stripe renvoie l'acheteur après paiement.
STRIPE_SECRET_KEY=

# Tarif Stripe Checkout en mode réel. Par défaut : « Prono du jour » à 1,00 €
# (price_1U9cHpDtqk1qvqGzPK7j5hi5). Pour les essais, créez un tarif en mode
# test et renseignez ici son identifiant (les tarifs réels et test sont isolés).
STRIPE_PRICE_ID=price_1U9cHpDtqk1qvqGzPK7j5hi5

# Secret du webhook Stripe (whsec_...). Facultatif mais recommandé : sans lui,
# un paiement dont l'acheteur ferme l'onglet avant la redirection n'est jamais
# comptabilisé. Obtenu en créant un endpoint dans le tableau de bord Stripe.
STRIPE_WEBHOOK_SECRET=

# --- Optionnel ---

# Taille maximale d'une photo de ticket, en Mo (défaut : 2).
MAX_PHOTO_MB=2

# Port d'écoute en local (ignoré en serverless).
PORT=3000

# Prix d'affichage et prix du mode démo en centimes (100 = 1,00 EUR). Gardez-le
# identique au tarif Stripe indiqué ci-dessus.
PRICE_CENTS=100
